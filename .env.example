# LA MESA — local environment template
# Copy to `.env.local` and fill values. Never commit secrets.

# --- Public app ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional NS Suite marketing link
# NEXT_PUBLIC_NS_SUITE_URL=

# --- Firebase client (Auth + optional client Firestore) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Named Firestore DB id if not "(default)". Keep client + server in sync:
# NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
# FIRESTORE_DATABASE_ID=
# FIREBASE_FIRESTORE_DATABASE_ID=

# Platform admins (comma-separated). Always includes gregory.prudhommeaux@gmail.com.
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=you@example.com

# --- Firebase Admin (server only — never NEXT_PUBLIC_*) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Prefer one of these for named DB (must match NEXT_PUBLIC_FIRESTORE_DATABASE_ID):
# FIRESTORE_DATABASE_ID=
# FIREBASE_FIRESTORE_DATABASE_ID=

# --- Email (Brevo) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=LA MESA <hello@lamesasecreta.com>
# Legacy alias still accepted as from-address fallback:
# RESEND_FROM_EMAIL=

# RSVP signed links — set a dedicated secret in production
RSVP_TOKEN_SECRET=

# --- AI (table builder + template translation) ---
# Prefer Perplexity for table ideas when set; else OpenAI; else AI Gateway.
# Profiles are exclusive — do not mix OPENAI_* keys with AI_GATEWAY_BASE_URL.
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TABLE_MODEL=gpt-4o-mini
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# AI Gateway requires BOTH key and base URL:
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_MODEL=

# --- Integrations ---
DATABASE_PERSO_BASE_URL=
DATABASE_PERSO_API_TOKEN=
CRON_SECRET=
# JEFFREY_STATS_SECRET=
FRANCONETWORK_IMPORT_SECRET=
# FN_FIREBASE_PROJECT_ID=
# FN_FIREBASE_CLIENT_EMAIL=
# FN_FIREBASE_PRIVATE_KEY=
# FN_FIRESTORE_DATABASE_ID=

# Legacy cookie admin gate (prefer Firebase platform admins). Optional for old tooling.
# ADMIN_PASSWORD=

# Dev-only: scan legacy Firestore collections when linking waitlist by email
# FIRESTORE_LEGACY_SCAN=1
